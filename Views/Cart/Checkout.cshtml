@model IEnumerable<Asuncion_Midterm_Store.Models.CartItem>

@{
    ViewData["Title"] = "Checkout";
    decimal grandTotal = Model.Sum(item => item.Price * item.Quantity);
}

<h1>Checkout</h1>

<h3>Order Summary</h3>

<table class="table">
    <thead>
        <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Quantity</th>
            <th>Total</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductName</td>
                <td>₱@item.Price</td>
                <td>@item.Quantity</td>
                <td>₱@(item.Price * item.Quantity)</td>
            </tr>
        }
    </tbody>
</table>

<h3>Grand Total: ₱@grandTotal</h3>

<hr />

<h3>Customer Information</h3>

<form asp-controller="Cart"
      asp-action="PlaceOrder"
      method="post">

    <div class="mb-3">
        <label class="form-label">Full Name</label>
        <input type="text"
               class="form-control"
               name="FullName"
               required />
    </div>

    <div class="mb-3">
        <label class="form-label">Address</label>
        <input type="text"
               class="form-control"
               name="Address"
               required />
    </div>

    <div class="mb-3">
        <label class="form-label">Contact Number</label>
        <input type="text"
               class="form-control"
               name="ContactNumber"
               required />
    </div>

    <button type="submit" class="btn btn-success">
        Place Order
    </button>
</form>