@model IEnumerable<Asuncion_Midterm_Store.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<h1>Products</h1>

<div class="mb-3">
    <a asp-action="Create" class="btn btn-success">
        Add Product
    </a>
</div>

<div class="row">
    @foreach (var product in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body">

                    <h5 class="card-title">
                        @product.Name
                    </h5>

                    <p class="card-text">
                        @product.Description
                    </p>

                    <p class="card-text">
                        <strong>Category:</strong> @product.Category
                    </p>

                    <h6 class="mb-3">
                        ₱@product.Price
                    </h6>

                    <form asp-controller="Cart"
                          asp-action="AddToCart"
                          method="post"
                          class="mb-2">

                        <input type="hidden"
                               name="productId"
                               value="@product.Id" />

                        <button type="submit"
                                class="btn btn-primary">
                            Add to Cart
                        </button>
                    </form>

                    <a asp-action="Edit"
                       asp-route-id="@product.Id"
                       class="btn btn-warning">
                        Edit
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@product.Id"
                       class="btn btn-danger">
                        Delete
                    </a>

                </div>
            </div>
        </div>
    }
</div>