@model IEnumerable<Asuncion_Midterm_Store.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
    decimal grandTotal = Model.Sum(item => item.Price * item.Quantity);
}

<h1>Shopping Cart</h1>

@if (!Model.Any())
{
    <p>Your cart is currently empty.</p>

    <a asp-controller="Products"
       asp-action="Index"
       class="btn btn-primary">
        Continue Shopping
    </a>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th>Action</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductName</td>

                    <td>
                        ₱@item.Price
                    </td>

                    <td>
                        <form asp-controller="Cart"
                              asp-action="UpdateQuantity"
                              method="post"
                              class="d-flex gap-2">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <input type="number"
                                   name="quantity"
                                   value="@item.Quantity"
                                   min="1"
                                   class="form-control"
                                   style="width: 90px;" />

                            <button type="submit"
                                    class="btn btn-warning">
                                Update
                            </button>

                        </form>
                    </td>

                    <td>
                        ₱@(item.Price * item.Quantity)
                    </td>

                    <td>
                        <form asp-controller="Cart"
                              asp-action="Remove"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn btn-danger">
                                Remove
                            </button>

                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3 class="text-end mb-3">
        Grand Total: ₱@grandTotal
    </h3>

    <div class="d-flex gap-2">

        <a asp-controller="Products"
           asp-action="Index"
           class="btn btn-secondary">
            Continue Shopping
        </a>

        <a asp-controller="Cart"
           asp-action="Checkout"
           class="btn btn-success">
            Checkout
        </a>

    </div>
}